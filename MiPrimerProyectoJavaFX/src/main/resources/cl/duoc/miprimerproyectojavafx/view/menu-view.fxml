<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.miprimerproyectojavafx.controller.MenuController">
   <children>
      <Label layoutX="224.0" layoutY="107.0" text="Mantenedor de Personas">
         <font>
            <Font name="System Bold" size="30.0" />
         </font>
      </Label>
      <VBox layoutX="350.0" layoutY="192.0" prefHeight="200.0" prefWidth="100.0">
         <children>
            <Button fx:id="btnCrear" mnemonicParsing="false" onAction="#onCrearButtonClick" prefWidth="150.0" text="Crear">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="btnListar" mnemonicParsing="false" onAction="#onListarButtonClick" prefWidth="150.0" text="Listar">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#onBuscarButtonClick" prefWidth="150.0" text="Buscar">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#onEditarButtonClick" prefWidth="150.0" text="Editar">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onEliminarButtonClick" prefWidth="150.0" text="Eliminar">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#onSalirButtonClick" prefWidth="150.0" text="Salir">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
